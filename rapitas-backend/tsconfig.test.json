{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    // Align with tsconfig.base.json ("bundler"); the old "node" (=node10) is
    // deprecated (TS5107) and hard-fails `tsc -p tsconfig.test.json`.
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "typeRoots": ["./node_modules/@types", "./@types"],
    "types": ["bun-test", "bun"]
  },
  "include": ["tests/**/*.ts", "tests/**/*.tsx", "scripts/codemods/__tests__/**/*.ts"],
  "exclude": ["node_modules/**/*"]
}
