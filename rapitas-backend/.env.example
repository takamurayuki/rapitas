# ============================================
# Rapitas Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ---- Server ----
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,tauri://localhost
FRONTEND_URL=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/rapitas

# ---- Encryption ----
# Master key used to encrypt sensitive data (API keys) in the DB.
# Resolution priority (first hit wins):
#   1. This env var (set in web/container/CI deployments)
#   2. OS keychain (macOS Keychain / Windows Credential Manager / libsecret)
#      service=rapitas, account=encryption-key  — populated automatically
#      on first run when no env var is set
#   3. ~/.rapitas/encryption.key                — fallback when keychain
#      is unavailable (headless Linux without libsecret, etc.)
#   4. Auto-generated and persisted to the highest available store
# Generate manually: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---- Admin ----
# Required in production for /agents/shutdown, /agents/restart, /agents/diagnose
# Generate: node -e "console.log(crypto.randomBytes(16).toString('hex'))"
ADMIN_SECRET=

# ---- AI Providers (optional, can be set via UI) ----
# All of these can also be set from Settings → API Keys in the app (stored
# encrypted in the DB) — env vars here are only a fallback/CI convenience.
# Get keys from: Anthropic https://console.anthropic.com/settings/keys,
# OpenAI https://platform.openai.com/api-keys,
# Google AI (Gemini) https://aistudio.google.com/app/apikey.
#
# Precedence for Claude (see utils/ai-client/credentials.ts#getApiKeyForProvider
# and services/agents/providers/anthropic-api-provider/provider.ts):
#   1. Per-agent config apiKey override (if set programmatically)
#   2. DB-stored key from Settings → API Keys (encrypted, preferred)
#   3. CLAUDE_API_KEY (this env var — used by the main getApiKeyForProvider path)
#   4. ANTHROPIC_API_KEY (last-resort fallback, only consulted directly by the
#      anthropic-api-provider when neither of the above is set)
# In short: CLAUDE_API_KEY wins over ANTHROPIC_API_KEY when both are set.
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ---- Auxiliary AI routing (naming, spec derivation, memory upkeep, reviews, chat) ----
# cli (default): route helper calls through the Claude Code CLI (subscription — NO
#   per-token billing). api: use the paid Anthropic API (legacy / escape hatch).
#   off: disable auxiliary AI entirely (features degrade gracefully).
RAPITAS_AUX_AI=cli
# Max concurrent CLI helper processes (default 2) — caps subscription rate-limit
# pressure and local CPU when the auto-run loop / memory queue fan out.
RAPITAS_AUX_AI_CLI_CONCURRENCY=2
# Per-call CLI helper timeout in ms (default 120000).
RAPITAS_AUX_AI_CLI_TIMEOUT_MS=120000

# ---- CLI Tool Paths (optional) ----
# Leave empty to use platform-aware defaults (Windows: claude.cmd / Linux+macOS: claude).
# Override only if the binary is in a non-standard location.
CLAUDE_CODE_PATH=
GEMINI_CLI_PATH=gemini
CODEX_CLI_PATH=codex

# ---- Google OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ---- File Storage ----
UPLOAD_DIR=uploads

# ---- Error Reporting (optional) ----
# When set, captured exceptions are forwarded to Sentry in addition to the
# always-on local ring buffer (visible in Settings → Recent errors).
# Leave empty for local-only capture (no external service required).
SENTRY_DSN=

# ---- Knowledge recall / embeddings ----
# Embedding model for the knowledge base (default: English-only MiniLM the
# existing index was built with). Set a multilingual model for Japanese recall,
# e.g. Xenova/paraphrase-multilingual-MiniLM-L12-v2 (384-dim, same as legacy).
# If it fails to load (offline), the legacy model is used and a warning logged.
RAPITAS_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Forgetting stages recalled from (comma list of active|dormant|archived).
RAPITAS_KB_RECALL_STAGES=active,dormant,archived
# Rank multiplier per stage (ordering only; archived stays a candidate).
RAPITAS_KB_RECALL_STAGE_WEIGHTS=active=1,dormant=0.85,archived=0.6
# Cosine floor for the vector channel (0..1).
RAPITAS_KB_RECALL_MIN_SIMILARITY=0.55
# Max knowledge entries injected into a prompt.
RAPITAS_KB_RECALL_MAX_ENTRIES=6
# Vector candidate pool = limit x multiplier before DB filtering.
RAPITAS_KB_RECALL_CANDIDATE_MULTIPLIER=5
# Bigram lexical channel (1 = on). Keeps Japanese queries recallable regardless of model.
RAPITAS_KB_RECALL_LEXICAL=1
# Lexical coverage score floor (0..1).
RAPITAS_KB_RECALL_LEXICAL_MIN_SCORE=0.15
# Lexical index cache lifetime (ms).
RAPITAS_KB_LEXICAL_INDEX_TTL_MS=600000
# Per-day decayScore retention at confidence 1.0 (0.5 < r < 1).
RAPITAS_KB_DECAY_DAILY_RETENTION=0.95
# Queue a re-embedding job at startup when the loaded model differs from the index (1 = on).
RAPITAS_KB_REINDEX_AUTO=1
# Re-embedding chunk size / pause between chunks (ms) / per-job budget (0 = unlimited).
RAPITAS_KB_REINDEX_BATCH_SIZE=50
RAPITAS_KB_REINDEX_PAUSE_MS=250
RAPITAS_KB_REINDEX_BUDGET=0

# ---- Git Cache (optional) ----
# Set to '0' to bypass all git caching layers (both local exec and remote URL).
# Useful for debugging stale-value issues.
RAPITAS_GIT_EXEC_CACHE=
# TTL in milliseconds for the local git exec cache (git rev-parse, etc.). Default: 30000
RAPITAS_GIT_EXEC_CACHE_TTL_MS=
# TTL in milliseconds for the git remote URL cache (git remote get-url origin). Default: 30000
RAPITAS_GIT_REMOTE_CACHE_TTL_MS=
