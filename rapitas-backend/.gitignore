.DS_Store

/generated/prisma
/generated/prisma-postgres
/generated/prisma-sqlite

# Workflow files written by AI agents (research.md / plan.md / verify.md per task).
# NOTE: Use a leading slash + trailing slash to anchor this to the backend root —
# without it, git would also match `routes/tasks/` and silently ignore real source
# files like recurring-tasks.ts, task-dependency-graph.ts, etc.
/tasks/

# Agent PID tracking files
.agent-pids/

# SQLite databases are runtime artifacts, not source. The schema lives in
# prisma/schema*/ and src/generated/sqlite-init-sql.ts. Nothing ignored these
# before, which let a 0-byte prisma/schema.desktop/dev.db slip into the repo.
*.db
*.db-wal
*.db-shm

# CI test timing cache generated by bun run test:timing
.rapitas-test-timing.json

# Run history for the test-correlation analysis. Runtime data, like the timing
# cache above: every `bun run test:ci` rewrites it, so a tracked copy turns up
# in the staging area of whatever change happens to be in progress. It got
# committed exactly that way once — 5,604 lines of it rode into #1267, a PR
# about per-account calendar connections — and has been noise in every
# `git status` since. Nothing in .github/workflows reads it; the path is
# overridable with RAPITAS_TEST_CORRELATION_HISTORY_PATH or RAPITAS_DATA_DIR.
test-correlation-run-history.json

# Scratch dir for test fixtures and gate run artifacts (created at backend cwd
# by *.test.ts TMP_ROOT and verification gate runs) — never source, never commit.
.tmp-tests/
# Ad-hoc verification scripts (agent scratch)
.tmp/
