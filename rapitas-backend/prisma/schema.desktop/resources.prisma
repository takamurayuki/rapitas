// A file or link attached to a task.
//
// NOTE: this lived in learning.prisma, which made it read as a study resource.
// It is a task attachment — FileUploader/FileViewer and the task detail panes
// are its only consumers — and it shared that file by accident. Kept when the
// learning features were removed.
model Resource {
  id          Int      @id @default(autoincrement())
  taskId      Int?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  url         String?
  type        String
  description String?
  // File upload fields
  filePath    String?
  fileName    String?
  fileSize    Int?
  mimeType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
