// A note.
//
// Notes lived only in the browser's localStorage until now, which meant they
// were per-device, invisible to the server, and unwritable by anything that
// was not a mounted React component. ラピ could only leave a note while her
// panel happened to be open.
//
// The id is a String rather than an autoincrement Int on purpose: every note
// already in a browser has a string id (`Date.now().toString()`), and task
// descriptions across the backlog already carry `/rapitas-note/{taskId}/{noteId}`
// chips pointing at those ids. Importing a local note under its own id keeps
// every one of those links working; an Int id would break them all.
model Note {
  id        String   @id
  /// Owning workspace; NULL = the default one until stage 4 makes this required.
  workspaceId Int?
  title     String
  content   String   @default("")
  isPinned  Boolean  @default(false)
  tags      String   @default("[]") // JSON array stored as string
  color     String?
  docType   String? // "要件定義" | "設計書" | "議事録" | "手順書" | "仕様書" | "メモ"
  /// SHA-256 of the normalised {title, content, tags, docType}. Written by the
  /// server only, in the same conditional update as the four fields, so a
  /// conditional write (`version = ifVersion`) can tell whether the note moved
  /// on since it was read. NULL only until the backfill reaches an old row.
  version   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Placement (notes stage 1, design §2.2) ──────────────────────────────
  // At most one of themeId / categoryId / folderId holds a value (checked in
  // the service layer). All three NULL = 未分類. The tree, the list and the
  // detail all derive placement from these columns only (describePlacement);
  // NoteTaskLink.meta and the title never decide where a note sits.
  themeId     Int?
  /// Only when the note sits directly under a category, outside any theme.
  categoryId  Int?
  /// A memo folder (NoteFolder, one level).
  folderId    Int?
  /// The task a deliverable note came from. One task, apart from the
  /// many-to-many NoteTaskLink. SetNull on task delete stops following.
  sourceTaskId Int?
  /// While true (and sourceTaskId is set) the placement follows the source
  /// task's effective theme when it changes to a non-NULL value.
  followsTask Boolean  @default(false)
  /// manual | chat | deliverable | research | roadmap | learning | material | knowledge (§3.2)
  source      String   @default("manual")
  /// JSON provenance, e.g. {"taskId":1,"fileType":"verify","sha256":"…","generatedAt":"…"}
  sourceRef   String?

  taskLinks  NoteTaskLink[]
  theme      Theme?      @relation(fields: [themeId], references: [id], onDelete: SetNull)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  folder     NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  sourceTask Task?       @relation(fields: [sourceTaskId], references: [id], onDelete: SetNull)

  @@index([updatedAt])
  @@index([isPinned])
  @@index([workspaceId])
  @@index([themeId])
  @@index([categoryId])
  @@index([folderId])
  @@index([sourceTaskId])
}

// A memo folder (design §2.3, Q3: one level). Only people create these; no
// automatic path ever places a note in one. Same-name folders are refused in
// the service layer, not by a unique index, because rows with a NULL
// workspaceId never collide in one (the RapiChatSpace.clientKey reasoning).
model NoteFolder {
  id          Int      @id @default(autoincrement())
  /// Owning workspace; NULL = the default one until stage 4 makes this required.
  workspaceId Int?
  name        String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  notes       Note[]

  @@index([workspaceId])
}

// The completion record the deliverable-note automation works from (design
// §3.3). One row per task. Entry points write it in the same transaction as
// the completion where they can; the hourly check creates `unknown` rows for
// completions no entry point saw. `completedAt` on Task is not relied on: some
// completion paths never write it.
model TaskDeliverableCompletion {
  taskId        Int       @id
  /// The task's workspace when the record was written.
  workspaceId   Int?
  /// manual | workflow_verify | ci_merge | recovery | reconciler_restore | unknown | baseline
  mode          String
  /// Same value as the task's updatedAt for entry-point completions.
  completedAt   DateTime
  /// baseline | pending | created | not_eligible | failed
  state         String
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([state])
}

// One-time data migrations of the notes domain that must not run twice
// (placement initial values, deliverable baseline). A run writes its key
// only after it finished, so a crash mid-run is resumed on the next start.
// The migrations cover every workspace at once, so a marker is written with
// workspaceId NULL and read by the unscoped jobs; the column is here because
// every directly-queried model carries one (tests/schema/workspace-tenancy).
model NoteMigrationMarker {
  key         String   @id
  /// Always NULL: one marker per migration for the whole database.
  workspaceId Int?
  appliedAt   DateTime @default(now())
  /// JSON summary of what the run did, for the operator.
  detail      String?

  @@index([workspaceId])
}

// A note attached to a task.
//
// Its own table rather than a JSON column on Note because the question asked
// in both directions — "which notes does this task have" as much as "which
// tasks does this note cover" — and the task side is what the task detail
// page reads.
model NoteTaskLink {
  id     Int    @id @default(autoincrement())
  /// Owning workspace; NULL = the default one until stage 4 makes this required.
  workspaceId Int?
  noteId String
  taskId Int
  // Hierarchy metadata captured when the link was made from a task context
  // (theme, project, parent task). JSON, because it is display context the
  // link carries rather than anything queried on.
  meta   String?

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([noteId, taskId])
  @@index([taskId])
  @@index([workspaceId])
}
