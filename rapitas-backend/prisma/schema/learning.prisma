model ExamGoal {
  id            Int       @id @default(autoincrement())
  name          String
  description   String?
  examDate      DateTime
  targetScore   String?
  color         String    @default("#10B981")
  icon          String?
  isCompleted   Boolean   @default(false)
  actualScore   String?
  tasks         Task[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model StudyStreak {
  id              Int      @id @default(autoincrement())
  date            DateTime @unique
  studyMinutes    Int      @default(0)
  tasksCompleted  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Learning goals (flexible goal setting → automatic task generation)
model LearningGoal {
  id              Int       @id @default(autoincrement())
  title           String    // Learning goal title (e.g., "Become a red coder in competitive programming")
  description     String?   // Detailed description of the goal
  currentLevel    String?   // Current level (e.g., "brown coder", "1 year of professional experience")
  targetLevel     String?   // Target level (e.g., "red coder", "10 million yen salary")
  deadline        DateTime? // Achievement deadline
  dailyHours      Float     @default(2) // Daily study hours
  categoryId      Int?      // Associated category
  themeId         Int?      // ID of the auto-generated theme
  status          String    @default("active") // active, completed, archived
  generatedPlan   String?   // JSON of the generated learning plan
  isApplied       Boolean   @default(false) // Whether applied as tasks
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Habit {
  id            Int           @id @default(autoincrement())
  name          String
  description   String?
  icon          String?
  color         String        @default("#10B981")
  frequency     String        @default("daily")
  targetCount   Int           @default(1)
  isActive      Boolean       @default(true)
  logs          HabitLog[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model HabitLog {
  id        Int      @id @default(autoincrement())
  habitId   Int
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime
  count     Int      @default(1)
  note      String?
  createdAt DateTime @default(now())

  @@unique([habitId, date])
}

// Vocabulary book (単語帳): decks of flashcards with per-card spaced-repetition
// state (SM-2-lite — see services/learning/vocab-srs.ts for the scheduler).
model VocabDeck {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  cards       VocabCard[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model VocabCard {
  id           Int       @id @default(autoincrement())
  deckId       Int
  deck         VocabDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front        String // term / prompt side
  back         String // meaning / answer side (summary, one meaning per line)
  note         String? // example sentence, mnemonic, etc.
  // Dictionary-style enrichment (all optional; the simple front/back flow works without them)
  syllables    String? // e.g. "con・found"
  pronunciation String? // e.g. "/kənˈfaʊnd/"
  partOfSpeech String? // e.g. 他動詞
  // JSON: VocabSense[] — per-sense meaning/example plus synonyms & antonyms
  // (see rapitas-frontend vocab.types.ts). Stored as a string for provider
  // portability (SQLite has no JSON column type).
  details      String?
  // SRS state (SM-2-lite)
  intervalDays Float     @default(0) // current review interval
  easeFactor   Float     @default(2.5) // growth multiplier, floored at 1.3
  repetitions  Int       @default(0) // consecutive successful reviews
  lapses       Int       @default(0) // times forgotten after being learned
  dueAt        DateTime  @default(now()) // next review due
  reviewedAt   DateTime? // last review timestamp
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([deckId, dueAt])
}

// One row per graded review — raw data for the forgetting-curve analytics.
// Deliberately no FK: logs must survive card/deck deletion so the learner's
// history (and the personal retention curve) never silently shrinks.
model VocabReviewLog {
  id           Int      @id @default(autoincrement())
  cardId       Int
  deckId       Int
  grade        String // again | good | easy
  elapsedDays  Float // time since the previous review (or card creation)
  intervalDays Float // the scheduled interval that was being tested
  repetitions  Int // successful repetitions BEFORE this review
  reviewedAt   DateTime @default(now())

  @@index([deckId, reviewedAt])
}

model Resource {
  id          Int      @id @default(autoincrement())
  taskId      Int?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  url         String?
  type        String
  description String?
  // File upload fields
  filePath    String?
  fileName    String?
  fileSize    Int?
  mimeType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
