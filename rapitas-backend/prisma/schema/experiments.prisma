// Experiment log - record all task executions as experiments
model Experiment {
  id            Int       @id @default(autoincrement())
  taskId        Int?
  title         String
  status        String    @default("created") // created, researching, hypothesizing, planning, executing, evaluating, learning, completed, failed
  research      String    @default("{}") // JSON: collected information
  hypothesis    String?   // JSON: generated hypothesis
  plan          String?   // JSON: execution plan
  execution     String?   // JSON: execution details
  result        String?   // JSON: execution result
  evaluation    String?   // JSON: evaluation metrics
  learning      String?   // JSON: extracted learnings
  criticReviewId Int?
  confidence    Float     @default(0)
  duration      Int?      // milliseconds
  metadata      String    @default("{}") // JSON: additional context
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  hypotheses    Hypothesis[]
  criticReviews CriticReview[]
  episodes      EpisodeMemory[]
  promptEvolutions PromptEvolution[]

  @@index([taskId])
  @@index([status])
  @@index([createdAt])
}

// Hypothesis management - track solution hypotheses
model Hypothesis {
  id            Int       @id @default(autoincrement())
  experimentId  Int
  experiment    Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  content       String    // Hypothesis content
  reasoning     String?   // Hypothesis rationale
  status        String    @default("proposed") // proposed, testing, validated, invalidated, revised
  confidence    Float     @default(0.5) // 0-1.0
  priority      Int       @default(50) // 0-100
  testResult    String?   // JSON: test outcome
  parentId      Int?      // Source of hypothesis revision
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([experimentId])
  @@index([status])
}

// Critic review - results from independent evaluation agent
model CriticReview {
  id            Int       @id @default(autoincrement())
  experimentId  Int
  experiment    Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  phase         String    // hypothesis, plan, execution
  accuracy      Float     @default(0) // 0-1.0
  logic         Float     @default(0) // 0-1.0
  coverage      Float     @default(0) // 0-1.0
  overallScore  Float     @default(0) // 0-1.0
  feedback      String    // Review comments
  suggestions   String    @default("[]") // JSON: improvement suggestions
  issues        String    @default("[]") // JSON: detected issues
  createdAt     DateTime  @default(now())

  @@index([experimentId])
  @@index([phase])
}

// Learning patterns - record success/failure patterns
model LearningPattern {
  id            Int       @id @default(autoincrement())
  patternType   String    // success_strategy, failure_pattern, optimization, anti_pattern
  category      String    // bug_fix, feature_implementation, refactoring, debugging, testing
  description   String
  conditions    String    @default("[]") // JSON: when this pattern applies
  actions       String    @default("[]") // JSON: recommended actions
  confidence    Float     @default(0.5) // 0-1.0
  occurrences   Int       @default(1) // how many times observed
  lastObserved  DateTime  @default(now())
  metadata      String    @default("{}") // JSON
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([patternType])
  @@index([category])
  @@index([confidence])
}

// Workflow learning records - actual workflow execution data from completed tasks
model WorkflowLearningRecord {
  id                    Int       @id @default(autoincrement())
  taskId                Int
  task                  Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workflowMode          String    // Actually used mode: lightweight, standard, comprehensive
  predictedComplexity   Float?    // Predicted complexity score
  actualDurationMinutes Int?      // Actual execution time (minutes)
  estimatedDuration     Int?      // Estimated execution time (minutes)
  skippedPhases         String    @default("[]") // JSON: Skipped phases ["research", "plan"]
  phaseTimings          String    @default("{}") // JSON: Duration of each phase {"research": 5, "plan": 10, ...}
  outcome               String    @default("completed") // completed, failed, cancelled
  wasOverridden         Boolean   @default(false) // Whether mode was manually changed
  overriddenFrom        String?   // Mode before change
  categoryId            Int?
  themeId               Int?
  labels                String    @default("[]") // JSON: Task label name array
  titleKeywords         String    @default("[]") // JSON: Keywords extracted from title
  complexityFactors     String    @default("{}") // JSON: Complexity analysis element scores
  success               Boolean   @default(true) // Whether workflow succeeded
  createdAt             DateTime  @default(now())

  @@index([workflowMode])
  @@index([themeId])
  @@index([categoryId])
  @@index([outcome])
  @@index([createdAt])
}

// Workflow optimization rules - patterns extracted from learning data
model WorkflowOptimizationRule {
  id                Int       @id @default(autoincrement())
  ruleType          String    // skip_phase, downgrade_mode, upgrade_mode, adjust_time
  condition         String    // JSON: Rule application condition
  recommendation    String    // JSON: Recommended action
  confidence        Float     @default(0.5) // 0-1.0
  sampleSize        Int       @default(0) // Number of samples used for rule generation
  successRate       Float     @default(0) // Success rate of tasks matching this rule
  description       String    // Human-readable description
  isActive          Boolean   @default(true)
  lastEvaluated     DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([ruleType])
  @@index([confidence])
  @@index([isActive])
}

// Detection-miss ledger — one row per quality-gate slip-through discovered
// AFTER the fact (task #578). A "miss" is deliberately narrow (precision over
// recall): only ci_repair transitions (verify passed, CI then failed) and
// concerns filed against an already-completed task qualify. verify_repair
// bounces are NOT misses — the gate caught those BEFORE completion.
model DetectionMissCase {
  id           Int      @id @default(autoincrement())
  taskId       Int
  /** Which gate the defect slipped past: ci_repair | post_completion_concern */
  gate         String
  /** Human-readable slip reason (transition metadata.reason / concern title). */
  reason       String   @default("")
  /** JSON evidence: transitionId/concernId, occurredAt, logRef, prNumber. */
  evidenceJson String   @default("{}")
  /** When the evidence event happened (not when this row was recorded). */
  detectedAt   DateTime @default(now())
  /** miss:<gate>:<taskId>:<discriminator> — absorbs re-scans of the same event. */
  dedupKey     String   @unique
  createdAt    DateTime @default(now())

  @@index([gate])
  @@index([taskId])
  @@index([detectedAt])
}

// Signature suggestions learned from detection-miss cases (task #578).
// Lifecycle mirrors PromptEvolution's human-in-the-loop pattern:
// pending_review → approved | rejected (human), or → auto_applied once the
// rejection rate stays under the auto threshold (mode derived statelessly —
// see services/self-improvement/miss-approval-mode.ts). auto_applied rows can
// still be rejected later by a human; that rejection re-enters the window and
// flips the mode back to manual.
model MissSignatureSuggestion {
  id          Int       @id @default(autoincrement())
  /** Source DetectionMissCase.id; null for signatures without a single case. */
  caseId      Int?
  /** The proposed detection cue (what the next watcher/reviewer should look for). */
  signature   String
  /** Why this cue predicts the defect type — required explanation text. */
  explanation String    @default("")
  status      String    @default("pending_review") // pending_review | approved | rejected | auto_applied
  /** Who decided: human | auto. Null while pending. */
  reviewedBy  String?
  reviewedAt  DateTime?
  /** suggest:<gate>:<signatureKey> — one row per distinct cue. */
  dedupKey    String    @unique
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([caseId])
  @@index([reviewedAt])
}

// Prompt evolution records - history of prompt improvements.
// NOTE: two-stage lifecycle. (1) status="pending" — queued by
// prompt-evolution-runner when a role's 7-day success rate drops below
// threshold; the before/after prompt pair is not generated yet. (2)
// status="completed" — recordPromptEvolution (or a follow-up worker) fills in
// the prompt pair and performanceDelta once the A/B result lands.
model PromptEvolution {
  id            Int       @id @default(autoincrement())
  experimentId  Int?
  experiment    Experiment? @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  // NOTE: kept non-null with "" default (not nullable) so generated types stay
  // `string` for existing readers (e.g. agent-knowledge-sharing); empty while pending.
  category      String    @default("") // research, hypothesis, planning, execution, evaluation
  beforePrompt  String    @default("") // empty while status="pending"
  afterPrompt   String    @default("") // empty while status="pending"
  improvement   String?   // what was improved
  performanceDelta Float  @default(0) // -1.0 to 1.0
  // Fields below back the runner-queued "pending" candidate stage.
  basePromptKey String?   // e.g. "workflow_role_planner" — which prompt to evolve
  reason        String?   // why this candidate was queued (success-rate evidence summary)
  status        String    @default("completed") // pending | completed; default keeps legacy writers as completed
  evidenceJson  String?   // JSON: aggregated metrics that triggered evolution
  createdAt     DateTime  @default(now())

  @@index([category])
  @@index([performanceDelta])
  @@index([status])
}
