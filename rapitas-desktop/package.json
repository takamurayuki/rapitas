{
  "name": "rapitas-desktop",
  "version": "1.0.0",
  "description": "Rapitas - AI-Powered Task Management Desktop App",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:watch": "node scripts/dev.js --watch",
    "dev:force": "node scripts/dev.js --force",
    "stop": "node scripts/dev.js --stop",
    "tauri": "node scripts/dep-sync.cjs --only desktop && tauri dev",
    "tauri:watch": "node scripts/dep-sync.cjs --only desktop && tauri dev -c src-tauri/tauri.watch.conf.json",
    "tauri:only": "node scripts/dep-sync.cjs --only desktop && tauri dev --no-dev-server",
    "build": "tauri build --features custom-protocol -c src-tauri/tauri.build.conf.json",
    "ci:prepare": "node scripts/ci-build.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  }
}
