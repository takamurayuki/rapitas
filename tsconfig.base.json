{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": [
    "Shared TypeScript baseline for all subprojects.",
    "",
    "This file is the SOURCE OF TRUTH for strictness flags. Both",
    "rapitas-backend/tsconfig.json and rapitas-frontend/tsconfig.json already",
    "`extend` this file — see ADR-0004 for the strictness ratchet schedule",
    "and history of the rollout.",
    "",
    "Each subproject's tsconfig.json layers its own env-specific fields",
    "on top (lib, jsx, moduleResolution, paths, plugins) that cannot be",
    "shared here.",
    "",
    "Last reviewed: 2026-07-03"
  ],
  "compilerOptions": {
    // ─── Output ──────────────────────────────────────────────────────────
    "noEmit": true,
    "incremental": true,
    "skipLibCheck": true,

    // ─── Module interop ──────────────────────────────────────────────────
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,

    // ─── Strictness baseline (CURRENTLY ACTIVE in both subprojects) ──────
    "strict": true,

    // ─── Strictness ratchet (rollout per ADR-0004) ────────────────────────
    // Step 1: enabled 2026-04-10 (both backend + frontend)
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "exactOptionalPropertyTypes": true,
    // "noUncheckedIndexedAccess": true,
    // "noImplicitReturns": true,

    // ─── Misc ────────────────────────────────────────────────────────────
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": false
  }
}
